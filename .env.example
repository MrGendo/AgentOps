# AgentOps 环境配置样例（复制为 .env 使用；真实密钥禁止提交）
# 数据库
AGENTOPS_DATABASE_URL=postgres://localhost:5432/agentops_dev?sslmode=disable
# Go 平台
AGENTOPS_PORT=8080
AGENTOPS_ROLE=all                # all | server | worker
AGENTOPS_WORKER_CONCURRENCY=2    # Worker 并发领取数
AGENTOPS_LEASE_TTL_SECONDS=30    # 租约时长（心跳与过期检测共用）
AGENTOPS_SERVICE_TOKEN=dev-service-token  # 内部接口令牌（Python↔Go）
# Python 智能与质量模块（阶段 C 起使用）
AGENTOPS_MODEL=mock              # mock | openai-compatible
AGENTOPS_MODEL_API_KEY=          # 真实模型密钥只放环境变量，不进代码
AGENTOPS_MODEL_BASE_URL=
# 数据保留
AGENTOPS_RAW_IO_RETENTION_DAYS=7 # 模型原始 IO 保留天数
